{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governed-agent-runtime.local/schemas/tool-result.schema.json",
  "title": "Tool Result Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_call_id",
    "tool_name",
    "status",
    "collected_at",
    "raw_reference",
    "result",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "tool_call_id": {
      "type": "string"
    },
    "tool_name": {
      "type": "string"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "PARTIAL",
        "TIMEOUT",
        "UNAVAILABLE"
      ]
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "raw_reference": {
      "type": "string"
    },
    "result": {
      "type": "object"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
