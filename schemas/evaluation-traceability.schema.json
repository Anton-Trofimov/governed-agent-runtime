{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governed-agent-runtime.local/schemas/evaluation-traceability.schema.json",
  "title": "Evaluation Traceability Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "model_context_file",
    "material_expectation_ids",
    "mappings"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "bounded_change_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "model_context_file": {
      "type": "string",
      "minLength": 1
    },
    "material_expectation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/explicitMapping"
          },
          {
            "$ref": "#/$defs/derivedMapping"
          }
        ]
      }
    }
  },
  "$defs": {
    "commonProperties": {
      "type": "object",
      "properties": {
        "expectation_id": {
          "type": "string",
          "minLength": 1
        },
        "required_behavior": {
          "type": "string",
          "minLength": 1
        },
        "visible_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "explicitMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectation_id",
        "required_behavior",
        "basis_type",
        "visible_refs",
        "semantic_review_required"
      ],
      "properties": {
        "expectation_id": {
          "type": "string",
          "minLength": 1
        },
        "required_behavior": {
          "type": "string",
          "minLength": 1
        },
        "basis_type": {
          "const": "EXPLICIT_MODEL_VISIBLE"
        },
        "visible_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "semantic_review_required": {
          "const": false
        }
      }
    },
    "derivedMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectation_id",
        "required_behavior",
        "basis_type",
        "visible_refs",
        "derivation",
        "semantic_review_required",
        "semantic_review_disposition"
      ],
      "properties": {
        "expectation_id": {
          "type": "string",
          "minLength": 1
        },
        "required_behavior": {
          "type": "string",
          "minLength": 1
        },
        "basis_type": {
          "const": "DERIVED_FROM_MODEL_VISIBLE"
        },
        "visible_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "derivation": {
          "type": "string",
          "minLength": 1
        },
        "semantic_review_required": {
          "const": true
        },
        "semantic_review_disposition": {
          "enum": [
            "APPROVED",
            "REJECTED",
            "PENDING"
          ]
        }
      }
    }
  }
}
