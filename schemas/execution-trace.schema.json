{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governed-agent-runtime.local/schemas/execution-trace.schema.json",
  "title": "Governed Execution Trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "session_id",
    "started_at",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "trace_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "terminal_outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "event_id",
          "event_type",
          "occurred_at",
          "visibility",
          "payload"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "event_id": {
            "type": "string"
          },
          "event_type": {
            "enum": [
              "CONTEXT_ASSEMBLED",
              "PROPOSAL_CREATED",
              "GATE_EVALUATED",
              "RUNTIME_DECISION",
              "TOOL_CALL_STARTED",
              "TOOL_RESULT_RECEIVED",
              "STATE_UPDATED",
              "CONFIRMATION_CREATED",
              "CONFIRMATION_UPDATED",
              "EXECUTION_STARTED",
              "EXECUTION_COMPLETED",
              "ERROR",
              "EVALUATION_RECORDED"
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "visibility": {
            "enum": [
              "MODEL_VISIBLE",
              "RUNTIME_ONLY",
              "EVALUATION_ONLY",
              "AUDIT_ONLY"
            ]
          },
          "payload": {
            "type": "object"
          },
          "raw_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "latency_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "token_usage": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "total_tokens": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "estimated_cost": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "currency": {
                "type": "string"
              },
              "amount": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "RUNTIME_DECISION"
                }
              },
              "required": [
                "event_type"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "#/$defs/runtimeDecisionPayload"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "STATE_UPDATED"
                }
              },
              "required": [
                "event_type"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "#/$defs/stateUpdatedPayload"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "TOOL_CALL_STARTED"
                }
              },
              "required": [
                "event_type"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "#/$defs/toolCallStartedPayload"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "event_type": {
                  "const": "TOOL_RESULT_RECEIVED"
                }
              },
              "required": [
                "event_type"
              ]
            },
            "then": {
              "properties": {
                "payload": {
                  "$ref": "#/$defs/toolResultReceivedPayload"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "runtimeDecisionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "proposal_id",
        "decision",
        "reason_codes",
        "next_state",
        "tool_execution_allowed",
        "confirmation_request_required"
      ],
      "properties": {
        "decision_id": {
          "type": "string"
        },
        "proposal_id": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "ALLOW",
            "PROVIDE_ANSWER",
            "ASK_CLARIFICATION",
            "REQUIRE_CONFIRMATION",
            "REPLACE_WITH_SAFER_PATH",
            "BLOCK",
            "SAFE_FALLBACK",
            "ESCALATE"
          ]
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "next_state": {
          "type": "string"
        },
        "safer_path": {
          "type": [
            "object",
            "null"
          ]
        },
        "tool_execution_allowed": {
          "type": "boolean"
        },
        "confirmation_request_required": {
          "type": "boolean"
        }
      }
    },
    "stateUpdatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "proposal_id",
        "application_rule_type",
        "application_rule_id",
        "lifecycle_disposition",
        "previous_state_version",
        "new_state_version",
        "previous_task_state",
        "new_task_state",
        "previous_phase",
        "new_phase",
        "action_ready_before",
        "action_ready_after",
        "terminal_outcome_before",
        "terminal_outcome_after"
      ],
      "properties": {
        "decision_id": {
          "type": "string"
        },
        "proposal_id": {
          "type": "string"
        },
        "application_rule_type": {
          "enum": [
            "STATE_TRANSITION",
            "DECISION_APPLICATION_RULE"
          ]
        },
        "application_rule_id": {
          "type": "string"
        },
        "lifecycle_disposition": {
          "type": [
            "string",
            "null"
          ]
        },
        "previous_state_version": {
          "type": "integer",
          "minimum": 1
        },
        "new_state_version": {
          "type": "integer",
          "minimum": 1
        },
        "previous_task_state": {
          "type": "string"
        },
        "new_task_state": {
          "type": "string"
        },
        "previous_phase": {
          "type": "string"
        },
        "new_phase": {
          "type": "string"
        },
        "action_ready_before": {
          "type": "boolean"
        },
        "action_ready_after": {
          "type": "boolean"
        },
        "terminal_outcome_before": {
          "type": [
            "string",
            "null"
          ]
        },
        "terminal_outcome_after": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "application_rule_type": {
                "const": "STATE_TRANSITION"
              }
            },
            "required": [
              "application_rule_type"
            ]
          },
          "then": {
            "properties": {
              "application_rule_id": {
                "pattern": "^T[0-9]{3}$"
              },
              "lifecycle_disposition": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "application_rule_type": {
                "const": "DECISION_APPLICATION_RULE"
              }
            },
            "required": [
              "application_rule_type"
            ]
          },
          "then": {
            "properties": {
              "application_rule_id": {
                "pattern": "^DA[0-9]{3}$"
              },
              "lifecycle_disposition": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "toolCallStartedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "session_id",
        "tool_call_id",
        "tool_name",
        "tool_category",
        "proposal_id",
        "decision_id",
        "runtime_decision",
        "arguments_hash",
        "arguments",
        "target",
        "idempotency_key",
        "started_at"
      ],
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "tool_call_id": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "tool_category": {
          "enum": [
            "read_only",
            "preparation",
            "state_changing"
          ]
        },
        "proposal_id": {
          "type": "string"
        },
        "decision_id": {
          "type": "string"
        },
        "runtime_decision": {
          "enum": [
            "ALLOW",
            "PROVIDE_ANSWER",
            "ASK_CLARIFICATION",
            "REQUIRE_CONFIRMATION",
            "REPLACE_WITH_SAFER_PATH",
            "BLOCK",
            "SAFE_FALLBACK",
            "ESCALATE"
          ]
        },
        "arguments_hash": {
          "type": "string"
        },
        "arguments": {
          "type": "object"
        },
        "target": {
          "type": "object"
        },
        "idempotency_key": {
          "type": "string"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "toolResultReceivedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "session_id",
        "tool_call_id",
        "tool_name",
        "proposal_id",
        "decision_id",
        "runtime_decision",
        "arguments_hash",
        "completed_at",
        "status",
        "raw_reference",
        "result",
        "errors",
        "tool_result"
      ],
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "tool_call_id": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "proposal_id": {
          "type": "string"
        },
        "decision_id": {
          "type": "string"
        },
        "runtime_decision": {
          "enum": [
            "ALLOW",
            "PROVIDE_ANSWER",
            "ASK_CLARIFICATION",
            "REQUIRE_CONFIRMATION",
            "REPLACE_WITH_SAFER_PATH",
            "BLOCK",
            "SAFE_FALLBACK",
            "ESCALATE"
          ]
        },
        "arguments_hash": {
          "type": "string"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "PARTIAL",
            "TIMEOUT",
            "UNAVAILABLE"
          ]
        },
        "raw_reference": {
          "type": "string"
        },
        "result": {
          "type": "object"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        },
        "tool_result": {
          "$ref": "#/$defs/toolResultEnvelope"
        }
      }
    },
    "toolResultEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tool_call_id",
        "tool_name",
        "status",
        "collected_at",
        "raw_reference",
        "result",
        "errors"
      ],
      "properties": {
        "schema_version": {
          "const": "0.1.0"
        },
        "tool_call_id": {
          "type": "string"
        },
        "tool_name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED",
            "PARTIAL",
            "TIMEOUT",
            "UNAVAILABLE"
          ]
        },
        "collected_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_timestamp": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "raw_reference": {
          "type": "string"
        },
        "result": {
          "type": "object"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "retryable"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
