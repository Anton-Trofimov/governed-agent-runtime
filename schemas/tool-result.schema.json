{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governed-agent-runtime.local/schemas/tool-result.schema.json",
  "title": "Tool Result Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_call_id",
    "tool_name",
    "status",
    "collected_at",
    "raw_reference",
    "result",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "tool_call_id": {
      "type": "string"
    },
    "tool_name": {
      "type": "string"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "PARTIAL",
        "TIMEOUT",
        "UNAVAILABLE"
      ]
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_timestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "raw_reference": {
      "type": "string"
    },
    "result": {
      "type": "object"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "$defs": {
    "remediationPlanResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remediation_plan_id",
        "plan_version",
        "readiness_status",
        "missing_preconditions",
        "validation_warnings"
      ],
      "properties": {
        "remediation_plan_id": {
          "type": "string",
          "minLength": 1
        },
        "plan_version": {
          "type": "string",
          "minLength": 1
        },
        "readiness_status": {
          "enum": [
            "PRECONDITIONS_PENDING",
            "READY_FOR_PRECONDITION_EVALUATION"
          ]
        },
        "missing_preconditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "validation_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tool_name": {
            "const": "create_remediation_plan"
          }
        },
        "required": [
          "tool_name"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "$ref": "#/$defs/remediationPlanResult"
          }
        }
      }
    }
  ]
}
