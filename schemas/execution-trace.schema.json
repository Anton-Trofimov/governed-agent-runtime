{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://governed-agent-runtime.local/schemas/execution-trace.schema.json",
  "title": "Governed Execution Trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "session_id",
    "started_at",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "trace_id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "terminal_outcome": {
      "type": [
        "string",
        "null"
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "event_id",
          "event_type",
          "occurred_at",
          "visibility",
          "payload"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "event_id": {
            "type": "string"
          },
          "event_type": {
            "enum": [
              "CONTEXT_ASSEMBLED",
              "PROPOSAL_CREATED",
              "GATE_EVALUATED",
              "RUNTIME_DECISION",
              "TOOL_CALL_STARTED",
              "TOOL_RESULT_RECEIVED",
              "STATE_UPDATED",
              "CONFIRMATION_CREATED",
              "CONFIRMATION_UPDATED",
              "EXECUTION_STARTED",
              "EXECUTION_COMPLETED",
              "ERROR",
              "EVALUATION_RECORDED"
            ]
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "visibility": {
            "enum": [
              "MODEL_VISIBLE",
              "RUNTIME_ONLY",
              "EVALUATION_ONLY",
              "AUDIT_ONLY"
            ]
          },
          "payload": {
            "type": "object"
          },
          "raw_reference": {
            "type": [
              "string",
              "null"
            ]
          },
          "latency_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "token_usage": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "total_tokens": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "estimated_cost": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "currency": {
                "type": "string"
              },
              "amount": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
